# Development PostgreSQL from compose.yaml. Do not reuse this password outside local development.
DATABASE_URL=postgresql://crypto:crypto_dev_only@127.0.0.1:5433/crypto_education
# MAX_BOT_TOKEN must come from the bot settings in MAX, never from a hackathon/team token.
# Docker Compose runs without a token in demo mode. Set NODE_ENV=production only together with a real MAX_BOT_TOKEN.
NODE_ENV=development
# MAX_BOT_TOKEN=
PORT=4100
# Optional public HTTPS origin for bot webhook; Render uses RENDER_EXTERNAL_URL automatically.
# MAX_BOT_PUBLIC_URL=https://your-service.example
