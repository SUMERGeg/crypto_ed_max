# Only local development values. Docker Compose supplies its own internal DATABASE_URL.
# Never reuse this disposable database password for a public deployment.
DATABASE_URL=postgresql://crypto:crypto_dev_only@127.0.0.1:5433/crypto_education
# Docker Compose starts in demo mode. Production requires MAX_BOT_TOKEN and DATABASE_URL.
NODE_ENV=development
PORT=4100
# Get the bot token from MAX bot settings; never commit it or use a hackathon/team token.
# MAX_BOT_TOKEN=
# Public HTTPS origin for the bot webhook outside Render (without /api/v1/bot/webhook).
# MAX_BOT_PUBLIC_URL=https://your-service.example
# Render normally provides this automatically; use it instead of MAX_BOT_PUBLIC_URL there.
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
